+static std::string_view ConfiguredPlayerCountry(s32 user_id) {
+#ifdef RYTY_NP_LIBRARY
+    const User* player = UserManagement.GetUserByID(user_id);
+    if (!player || player->player_index != 1) {
+        return {};
+    }
+    static const std::string country = []() -> std::string {
+        const auto ini = Common::ReadFileW(Common::RytyExeDirW() + L"RyGT.ini");
+        const auto trim = [](std::string_view text) {
+            const auto start = text.find_first_not_of(" \t\r");
+            return start == text.npos ? std::string_view{} :
+                text.substr(start, text.find_last_not_of(" \t\r") - start + 1);
+        };
+        std::string value;
+        for (size_t start = 0; start < ini.size();) {
+            const auto end = ini.find('\n', start);
+            std::string_view line(ini.data() + start,
+                                  (end == ini.npos ? ini.size() : end) - start);
+            if (start == 0 && line.starts_with("\xEF\xBB\xBF")) {
+                line.remove_prefix(3);
+            }
+            const auto equals = line.find('=');
+            if (equals != line.npos && trim(line.substr(0, equals)) == "player_country") {
+                value = trim(line.substr(equals + 1));
+            }
+            start = end == ini.npos ? ini.size() : end + 1;
+        }
+        if (value.size() != 2) {
+            return {};
+        }
+        for (char& letter : value) {
+            if (letter >= 'A' && letter <= 'Z') {
+                letter += 'a' - 'A';
+            }
+            if (letter < 'a' || letter > 'z') {
+                return {};
+            }
+        }
+        return value;
+    }();
+    return country;
+#else
+    return {};
+#endif
+}
