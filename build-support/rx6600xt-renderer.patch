+namespace Vulkan {
+namespace {
+namespace fs = std::filesystem;
+constexpr size_t MaxFileBytes = 4u << 20;
+constexpr u64 MaxDirectoryBytes = 256ull << 20;
+
+std::string DriverKey(vk::Device device, const VkPipelineCreateInfoKHR* info) {
+    VkPipelineBinaryKeyKHR key{VK_STRUCTURE_TYPE_PIPELINE_BINARY_KEY_KHR};
+    if (VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPipelineKeyKHR(device, info, &key) != VK_SUCCESS ||
+        !key.keySize || key.keySize > sizeof(key.key)) {
+        return {};
+    }
+    return fmt::format("{:02x}", fmt::join(std::span(key.key, key.keySize), ""));
+}
+
+// Each file contains a checksum followed by a length-prefixed driver key and its binary.
+// Both the device-wide key and the pipeline key must match before any data goes to Vulkan.
+std::vector<u8> ReadBinary(const fs::path& file) {
+    std::ifstream in{file, std::ios::binary | std::ios::ate};
+    const std::streamoff size = in.tellg();
+    if (size < 11 || size > MaxFileBytes) {
+        return {};
+    }
+    in.seekg(0);
+    u64 checksum;
+    std::vector<u8> bytes(size_t(size) - sizeof(checksum));
+    if (!in.read(reinterpret_cast<char*>(&checksum), sizeof(checksum)) ||
+        !in.read(reinterpret_cast<char*>(bytes.data()), bytes.size()) || bytes[0] == 0 ||
+        bytes[0] > VK_MAX_PIPELINE_BINARY_KEY_SIZE_KHR || bytes.size() <= 1u + bytes[0] ||
+        checksum != XXH3_64bits(bytes.data(), bytes.size())) {
+        return {};
+    }
+    return bytes;
+}
+
+class DiskBudget {
+public:
+    bool HasRoom(const fs::path& dir, size_t bytes) {
+        std::scoped_lock lk{mutex};
+        return HasRoomLocked(dir, bytes);
+    }
+
+    bool Save(const fs::path& file, const std::vector<u8>& bytes) {
+        std::scoped_lock lk{mutex};
+        const size_t size = bytes.size() + sizeof(u64);
+        const auto dir = file.parent_path();
+        if (!HasRoomLocked(dir, size)) {
+            return false;
+        }
+        std::error_code ec;
+        fs::create_directories(dir, ec);
+        if (ec) {
+            return false;
+        }
+        auto temporary = file;
+        temporary +=
+            fmt::format(".{}.tmp", std::chrono::steady_clock::now().time_since_epoch().count());
+        std::ofstream out{temporary, std::ios::binary};
+        const u64 checksum = XXH3_64bits(bytes.data(), bytes.size());
+        out.write(reinterpret_cast<const char*>(&checksum), sizeof(checksum));
+        out.write(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+        out.close();
+        const auto old = fs::file_size(file, ec);
+        const auto replaced = ec ? 0 : old;
+        if (out) {
+            fs::rename(temporary, file, ec);
+            if (!ec) {
+                auto& used = sizes.at(dir);
+                used = used - std::min<u64>(used, replaced) + size;
+                return true;
+            }
+        }
+        fs::remove(temporary, ec);
+        return false;
+    }
+
+private:
+    bool HasRoomLocked(const fs::path& dir, size_t bytes) {
+        auto [it, inserted] = sizes.try_emplace(dir, 0);
+        if (inserted) {
+            std::error_code ec;
+            fs::directory_iterator entries{dir, ec};
+            for (; !ec && entries != fs::directory_iterator{}; entries.increment(ec)) {
+                if (entries->path().extension() == ".bin") {
+                    std::error_code size_ec;
+                    const auto size = entries->file_size(size_ec);
+                    if (!size_ec) {
+                        it->second += size;
+                    }
+                }
+            }
+        }
+        const auto limit = std::min(DriverCacheMaxBytes(), MaxDirectoryBytes);
+        return bytes <= limit && it->second <= limit - bytes;
+    }
+
+    std::mutex mutex;
+    std::map<fs::path, u64> sizes;
+};
+
+struct BinaryHandle {
+    vk::Device device;
+    VkPipelineBinaryKHR binary{};
+    ~BinaryHandle() {
+        if (binary) {
+            VULKAN_HPP_DEFAULT_DISPATCHER.vkDestroyPipelineBinaryKHR(device, binary, nullptr);
+        }
+    }
+};
+
+vk::UniquePipeline Restore(vk::Device device, vk::GraphicsPipelineCreateInfo info,
+                           std::vector<u8>& bytes) {
+    VkPipelineBinaryKeyKHR key{VK_STRUCTURE_TYPE_PIPELINE_BINARY_KEY_KHR};
+    key.keySize = bytes[0];
+    std::memcpy(key.key, bytes.data() + 1, key.keySize);
+    const size_t offset = 1 + key.keySize;
+    const VkPipelineBinaryDataKHR data{bytes.size() - offset, bytes.data() + offset};
+    const VkPipelineBinaryKeysAndDataKHR input{1, &key, &data};
+    VkPipelineBinaryCreateInfoKHR source{VK_STRUCTURE_TYPE_PIPELINE_BINARY_CREATE_INFO_KHR};
+    source.pKeysAndDataInfo = &input;
+    BinaryHandle binary{device};
+    VkPipelineBinaryHandlesInfoKHR handles{VK_STRUCTURE_TYPE_PIPELINE_BINARY_HANDLES_INFO_KHR,
+                                           nullptr, 1, &binary.binary};
+    if (VULKAN_HPP_DEFAULT_DISPATCHER.vkCreatePipelineBinariesKHR(device, &source, nullptr,
+                                                                  &handles) != VK_SUCCESS ||
+        !binary.binary) {
+        return {};
+    }
+    VkPipelineBinaryInfoKHR restore{VK_STRUCTURE_TYPE_PIPELINE_BINARY_INFO_KHR, info.pNext, 1,
+                                    &binary.binary};
+    info.pNext = &restore;
+    auto restored = device.createGraphicsPipelineUnique({}, info);
+    return restored.result == vk::Result::eSuccess ? std::move(restored.value)
+                                                   : vk::UniquePipeline{};
+}
+
+std::vector<u8> Extract(vk::Device device, vk::Pipeline pipeline) {
+    auto& api = VULKAN_HPP_DEFAULT_DISPATCHER;
+    VkPipelineBinaryCreateInfoKHR source{VK_STRUCTURE_TYPE_PIPELINE_BINARY_CREATE_INFO_KHR};
+    source.pipeline = pipeline;
+    BinaryHandle binary{device};
+    VkPipelineBinaryHandlesInfoKHR handles{VK_STRUCTURE_TYPE_PIPELINE_BINARY_HANDLES_INFO_KHR,
+                                           nullptr, 1, &binary.binary};
+    if (api.vkCreatePipelineBinariesKHR(device, &source, nullptr, &handles) != VK_SUCCESS ||
+        handles.pipelineBinaryCount != 1 || !binary.binary) {
+        return {};
+    }
+    VkPipelineBinaryDataInfoKHR data{VK_STRUCTURE_TYPE_PIPELINE_BINARY_DATA_INFO_KHR, nullptr,
+                                     binary.binary};
+    VkPipelineBinaryKeyKHR key{VK_STRUCTURE_TYPE_PIPELINE_BINARY_KEY_KHR};
+    size_t size = 0;
+    if (api.vkGetPipelineBinaryDataKHR(device, &data, &key, &size, nullptr) != VK_SUCCESS ||
+        !size || size > MaxFileBytes - sizeof(u64) - 1 - sizeof(key.key) || !key.keySize ||
+        key.keySize > sizeof(key.key)) {
+        return {};
+    }
+    const auto key_size = key.keySize;
+    std::vector<u8> bytes(1 + key_size + size);
+    if (api.vkGetPipelineBinaryDataKHR(device, &data, &key, &size, bytes.data() + 1 + key_size) !=
+            VK_SUCCESS ||
+        key.keySize != key_size || size == 0) {
+        return {};
+    }
+    bytes.resize(1 + key_size + size);
+    bytes[0] = static_cast<u8>(key_size);
+    std::memcpy(bytes.data() + 1, key.key, key_size);
+    return bytes;
+}
+} // namespace
+
+vk::UniquePipeline LoadOrCaptureGraphicsPipeline(vk::Device device,
+                                                 vk::GraphicsPipelineCreateInfo info) {
+    if (!VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPipelineKeyKHR) {
+        return {};
+    }
+    VkPipelineCreateInfoKHR query{VK_STRUCTURE_TYPE_PIPELINE_CREATE_INFO_KHR, &info};
+    const auto global = DriverKey(device, nullptr);
+    const auto key = DriverKey(device, &query);
+    if (global.empty() || key.empty()) {
+        return {};
+    }
+    const auto& serial = Common::Singleton<Common::ElfInfo>::Instance()->GameSerial();
+    const auto dir = Common::FS::GetUserPath(Common::FS::PathType::CacheDir) /
+                     fmt::format("{}.graphics-binaries", serial) / global;
+    const auto file = dir / (key + ".bin");
+    auto bytes = ReadBinary(file);
+    if (!bytes.empty()) {
+        if (auto ready = Restore(device, info, bytes)) {
+            static std::atomic<u32> restored{};
+            const u32 n = ++restored;
+            if (n == 1 || n % 64 == 0) {
+                LOG_INFO(Render_Vulkan, "Restored {} compiled graphics pipelines from disk", n);
+            }
+            return ready;
+        }
+    }
+    static DiskBudget budget;
+    if (!budget.HasRoom(dir, 1)) {
+        return {};
+    }
+    VkPipelineCreateFlags2CreateInfoKHR flags{
+        VK_STRUCTURE_TYPE_PIPELINE_CREATE_FLAGS_2_CREATE_INFO_KHR, info.pNext,
+        VkPipelineCreateFlags(info.flags) | VK_PIPELINE_CREATE_2_CAPTURE_DATA_BIT_KHR};
+    info.pNext = &flags;
+    auto captured = device.createGraphicsPipelineUnique({}, info);
+    if (captured.result != vk::Result::eSuccess) {
+        return {};
+    }
+    bytes = Extract(device, *captured.value);
+    VkReleaseCapturedPipelineDataInfoKHR release{
+        VK_STRUCTURE_TYPE_RELEASE_CAPTURED_PIPELINE_DATA_INFO_KHR};
+    release.pipeline = *captured.value;
+    VULKAN_HPP_DEFAULT_DISPATCHER.vkReleaseCapturedPipelineDataKHR(device, &release, nullptr);
+    if (!bytes.empty() && budget.Save(file, bytes)) {
+        static std::atomic<u32> saved{};
+        const u32 n = ++saved;
+        if (n == 1 || n % 64 == 0) {
+            LOG_INFO(Render_Vulkan, "Saved {} compiled graphics pipelines to disk", n);
+        }
+    }
+    return std::move(captured.value);
+}
+} // namespace Vulkan
